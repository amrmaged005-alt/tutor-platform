"use client";

import { motion } from "framer-motion";

// ─── SKELETON CARD ─────────────────────────────────────────────────────────────
// Shows while tutor/center data is loading.
// The shimmer animation makes it feel like content is "arriving" not "broken".
// Use this instead of spinners — it preserves layout and feels professional.

interface SkeletonCardProps {
  variant?: "tutor" | "center" | "class";
}

// The shimmer effect is a gradient that slides across the placeholder
const shimmer = {
  animate: {
    backgroundPosition: ["200% 0", "-200% 0"],
  },
  transition: {
    duration: 1.8,
    repeat: Infinity,
    ease: "linear",
  },
};

// A single skeleton "line" placeholder
function SkeletonLine({
  width = "100%",
  height = 14,
  borderRadius = 8,
}: {
  width?: string | number;
  height?: number;
  borderRadius?: number;
}) {
  return (
    <motion.div
      animate={shimmer.animate}
      transition={shimmer.transition}
      style={{
        width,
        height,
        borderRadius,
        background:
          "linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%)",
        backgroundSize: "400% 100%",
      }}
    />
  );
}

export default function SkeletonCard({ variant = "tutor" }: SkeletonCardProps) {
  if (variant === "tutor") {
    return (
      <div
        style={{
          background: "#1e293b",
          borderRadius: "20px",
          padding: "24px",
          border: "1px solid #334155",
          display: "flex",
          flexDirection: "column",
          gap: "16px",
        }}
      >
        {/* Avatar placeholder */}
        <div style={{ display: "flex", justifyContent: "center" }}>
          <motion.div
            animate={shimmer.animate}
            transition={shimmer.transition}
            style={{
              width: 72,
              height: 72,
              borderRadius: "50%",
              background:
                "linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%)",
              backgroundSize: "400% 100%",
            }}
          />
        </div>

        {/* Name */}
        <div style={{ display: "flex", flexDirection: "column", gap: "8px", alignItems: "center" }}>
          <SkeletonLine width="60%" height={18} />
          <SkeletonLine width="40%" height={14} />
        </div>

        {/* Stars */}
        <SkeletonLine width="50%" height={12} />

        {/* Tags */}
        <div style={{ display: "flex", gap: "8px" }}>
          <SkeletonLine width="70px" height={26} borderRadius={999} />
          <SkeletonLine width="80px" height={26} borderRadius={999} />
        </div>

        {/* Stats */}
        <div style={{ display: "flex", flexDirection: "column", gap: "6px" }}>
          <SkeletonLine width="80%" height={12} />
          <SkeletonLine width="65%" height={12} />
          <SkeletonLine width="70%" height={12} />
        </div>

        {/* Buttons */}
        <div style={{ display: "flex", gap: "8px", marginTop: "8px" }}>
          <SkeletonLine width="50%" height={40} borderRadius={10} />
          <SkeletonLine width="50%" height={40} borderRadius={10} />
        </div>
      </div>
    );
  }

  if (variant === "center") {
    return (
      <div
        style={{
          background: "#1e293b",
          borderRadius: "20px",
          overflow: "hidden",
          border: "1px solid #334155",
        }}
      >
        {/* Banner */}
        <motion.div
          animate={shimmer.animate}
          transition={shimmer.transition}
          style={{
            width: "100%",
            height: 120,
            background:
              "linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%)",
            backgroundSize: "400% 100%",
          }}
        />
        <div style={{ padding: "20px", display: "flex", flexDirection: "column", gap: "12px" }}>
          <SkeletonLine width="70%" height={20} />
          <SkeletonLine width="50%" height={14} />
          <SkeletonLine width="90%" height={12} />
          <SkeletonLine width="40%" height={40} borderRadius={10} />
        </div>
      </div>
    );
  }

  // "class" variant
  return (
    <div
      style={{
        background: "#1e293b",
        borderRadius: "20px",
        padding: "20px",
        border: "1px solid #334155",
        display: "flex",
        flexDirection: "column",
        gap: "12px",
      }}
    >
      <SkeletonLine width="80%" height={20} />
      <SkeletonLine width="50%" height={14} />
      <SkeletonLine width="60%" height={12} />
      <SkeletonLine width="40%" height={12} />
      <SkeletonLine width="100%" height={40} borderRadius={10} />
    </div>
  );
}