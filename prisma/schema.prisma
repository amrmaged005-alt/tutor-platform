generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TUTOR
  CENTER_ADMIN
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum ClassFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum Curriculum {
  NATIONAL
  IGCSE
  AMERICAN
  IB
  FRENCH
  STEM
  OTHER
}

model User {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  role          Role      @default(STUDENT)
  fullName      String?
  phone         String?   @unique
  bio           String?
  photoUrl      String?
  subjects      String[]

  centerId      String?
  center        LearningCenter? @relation(fields: [centerId], references: [id])

  accounts      Account[]
  sessions      Session[]
  classTutors   ClassTutor[]
  bookings      Booking[]
  ownedClasses  Class[]   @relation("ClassOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LearningCenter {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  description String?
  logoUrl     String?
  city        String   @default("Cairo")
  location    String?
  phone       String?
  email       String?

  tutors      User[]
  classes     Class[]
}

model Class {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  title       String
  subject     String
  description String?
  city        String      @default("Cairo")
  location    String?
  priceEgp    Int         @default(0)
  capacity    Int?
  isOnline    Boolean     @default(false)
  schedule    String?

  // NEW FIELDS
  format      ClassFormat @default(IN_PERSON)
  curriculum  Curriculum  @default(NATIONAL)
  gradeLevel  String?
  language    String      @default("Arabic")
  maxPrice    Int?

  centerId    String?
  center      LearningCenter? @relation(fields: [centerId], references: [id])

  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], name: "ClassOwner")

  tutors      ClassTutor[]
  bookings    Booking[]
  materials   Material[]
}

model ClassTutor {
  id        String @id @default(cuid())
  classId   String
  tutorId   String

  class     Class  @relation(fields: [classId], references: [id])
  tutor     User   @relation(fields: [tutorId], references: [id])

  @@unique([classId, tutorId])
}

model Booking {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  classId       String
  studentId     String

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  notes         String?

  class         Class         @relation(fields: [classId], references: [id])
  student       User          @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
}

model Material {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  classId   String
  title     String
  url       String?
  fileUrl   String?
  isLocked  Boolean  @default(true)

  class     Class    @relation(fields: [classId], references: [id])
}