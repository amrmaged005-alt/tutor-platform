generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TUTOR
  CENTER_ADMIN
  ADMIN
}

// What a tutor can see/do inside their learning center
enum CenterAccessLevel {
  FULL
  LIMITED
  VIEW_ONLY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ClassFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum PaymentType {
  IN_PERSON
  ONLINE
}

enum Curriculum {
  NATIONAL
  IGCSE
  AMERICAN
  IB
  FRENCH
  STEM
  OTHER
}

// ─── Auth Models (NextAuth required) ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Auth Security: tokens + login audit ──────────────────────────────────────

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  role     Role     @default(STUDENT)
  fullName String?
  phone    String?  @unique
  bio      String?
  photoUrl String?
  subjects String[]

  // Paymob (for tutors/centers receiving payouts)
  paymobAccountId String?
  paymobOnboarded Boolean @default(false)

  // Trust & verification
  isEmailVerified Boolean @default(false)
  isVerified      Boolean @default(false)
  trustScore      Int     @default(50)
  isSuspended     Boolean @default(false)

  // Auth security (account lockout + login telemetry)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  passwordChangedAt DateTime?
  // Bumped to invalidate all existing JWT sessions ("sign out everywhere")
  sessionVersion   Int       @default(0)

  centerId String?
  center   LearningCenter? @relation(fields: [centerId], references: [id])
  // Agreement level between a center and this tutor (only meaningful when centerId is set)
  centerAccessLevel CenterAccessLevel @default(FULL)

  // T15: Notification preferences
  notifyBookingConfirmed Boolean @default(true)
  notifyBookingCancelled Boolean @default(true)
  notifyNewMessage       Boolean @default(true)
  notifyWaitlistOpened   Boolean @default(true)
  notifyReviewReceived   Boolean @default(true)
  notifyPayoutProcessed  Boolean @default(true)
  notifyMarketingEmails  Boolean @default(false)

  // T18: Referral + wallet
  referralCode     String? @unique
  walletBalanceEgp Int     @default(0)

  accounts          Account[]
  sessions          Session[]
  classTutors       ClassTutor[]
  bookings          Booking[]
  ownedClasses      Class[]            @relation("ClassOwner")
  reviews           Review[]
  payouts           Payout[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  pushTokens        PushToken[]
  favorites         Favorite[]
  studentThreads    MessageThread[]    @relation("StudentThreads")
  tutorThreads      MessageThread[]    @relation("TutorThreads")
  sentMessages      Message[]
  waitlistEntries   Waitlist[]
  promoCodes        PromoCode[]
  studentAttendance AttendanceRecord[] @relation("StudentAttendance")
  tutorAttendance   AttendanceRecord[] @relation("TutorAttendance")
  referralsSent     Referral[]         @relation("ReferralsSent")
  referralReceived  Referral?          @relation("ReferralReceived")
  searchLogs        SearchLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  loginAuditLogs          LoginAuditLog[]

  @@index([role])
  @@index([centerId])
  @@index([email])
  @@index([referralCode])
}

model LearningCenter {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  logoUrl     String?
  city        String  @default("Cairo")
  location    String?
  phone       String?
  email       String?

  // Paymob (for centers receiving payouts)
  paymobAccountId String?
  paymobOnboarded Boolean @default(false)

  tutors  User[]
  classes Class[]
}

model Class {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  subject     String
  description String?
  city        String  @default("Cairo")
  location    String?
  priceEgp    Int     @default(0)
  capacity    Int     @default(20)
  isOnline    Boolean @default(false)
  imageUrl    String? // optional cover image; falls back to a deterministic gradient
  isActive    Boolean @default(true)
  schedule    String? // legacy display fallback

  // A1: Structured schedule fields
  startDate       DateTime?
  endDate         DateTime?
  sessionDays     String[]
  sessionTimeFrom String?
  sessionTimeTo   String?
  recurrence      String? // "weekly" | "biweekly" | "once"

  format      ClassFormat @default(IN_PERSON)
  paymentType PaymentType @default(IN_PERSON)
  curriculum  Curriculum  @default(NATIONAL)
  gradeLevel  String?
  language    String      @default("Arabic")
  maxPrice    Int?

  // T3: Session packages (Fiverr-style tiered pricing)
  packagesEnabled Boolean @default(false)
  packageOptions  Json?
  // packageOptions shape: [{ sessions: number, discountPct: number }]

  centerId String?
  center   LearningCenter? @relation(fields: [centerId], references: [id])

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], name: "ClassOwner")

  tutors      ClassTutor[]
  bookings    Booking[]
  materials   Material[]
  reviews     Review[]
  favoritedBy Favorite[]
  waitlist    Waitlist[]
  attendance  AttendanceRecord[]

  @@index([subject])
  @@index([city])
  @@index([format])
  @@index([curriculum])
  @@index([ownerId])
  @@index([centerId])
  @@index([priceEgp])
  @@index([isActive])
  @@index([title])
  @@index([createdAt])
}

model ClassTutor {
  id      String @id @default(cuid())
  classId String
  tutorId String

  class Class @relation(fields: [classId], references: [id])
  tutor User  @relation(fields: [tutorId], references: [id])

  @@unique([classId, tutorId])
}

model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId   String
  studentId String

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  notes         String?

  // Payment tracking
  amountEgp        Int?
  platformFeeEgp   Int?
  tutorPayoutEgp   Int?
  paymobOrderId    String? @unique
  paymobPaymentKey String?
  idempotencyKey   String? @unique

  // Seat lock (prevents double-booking during checkout)
  lockedAt    DateTime?
  lockedUntil DateTime?

  // Refund tracking
  refundedAt   DateTime?
  refundReason String?

  // T12: Promo code
  promoCode        String?
  promoDiscountEgp Int?

  class   Class @relation(fields: [classId], references: [id])
  student User  @relation(fields: [studentId], references: [id])

  webhookEvents WebhookEvent[]
  payout        Payout?
  attendance    AttendanceRecord[]

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([classId])
  @@index([status])
  @@index([lockedUntil])
  @@index([createdAt])
  @@index([paymentStatus])
}

model Material {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  classId  String
  title    String
  url      String?
  fileUrl  String?
  type     String?
  isLocked Boolean @default(true)

  class Class @relation(fields: [classId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId   String
  studentId String
  rating    Int
  comment   String?

  // A2: Review moderation
  isApproved  Boolean   @default(false)
  moderatedAt DateTime?

  // T13: Tutor response
  tutorResponse    String?
  tutorRespondedAt DateTime?

  class   Class @relation(fields: [classId], references: [id])
  student User  @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([classId, isApproved])
  @@index([studentId])
}

// A3: Favorites
model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  classId   String?
  tutorId   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
  @@unique([userId, tutorId])
  @@index([userId])
}

// A4: Messaging
model MessageThread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String
  tutorId   String
  student   User   @relation("StudentThreads", fields: [studentId], references: [id])
  tutor     User   @relation("TutorThreads", fields: [tutorId], references: [id])

  messages Message[]

  @@unique([studentId, tutorId])
  @@index([studentId])
  @@index([tutorId])
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  threadId String
  senderId String
  content  String
  isRead   Boolean @default(false)

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String
  token      String    @unique
  platform   String
  appVersion String?
  deviceId   String?
  disabledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@index([disabledAt])
}

// ─── Payment Models ───────────────────────────────────────────────────────────

model WebhookEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  paymobTransactionId String  @unique
  type                String
  processed           Boolean @default(false)
  processingError     String?

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  payload Json

  @@index([paymobTransactionId])
  @@index([processed])
  @@index([createdAt])
}

model Payout {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipientId   String
  recipientType String // "tutor" | "center"
  recipient     User   @relation(fields: [recipientId], references: [id])

  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])

  paymobTransferId String?      @unique
  amountEgp        Int
  status           PayoutStatus @default(PENDING)
  failureReason    String?

  @@index([recipientId])
  @@index([status])
}

// ─── Waitlist ─────────────────────────────────────────────────────────────────

model Waitlist {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  userId     String
  classId    String
  notifiedAt DateTime?
  position   Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
  @@index([classId, createdAt])
}

// ─── Security Models ──────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actorId   String?
  actorRole String?
  actor     User?   @relation("AuditActor", fields: [actorId], references: [id])

  action     String
  targetType String?
  targetId   String?

  metadata  Json?
  ipAddress String?
  userAgent String?

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ─── T12: Promo Codes ─────────────────────────────────────────────────────────

model PromoCode {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  code        String    @unique
  discountPct Int
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])

  @@index([code])
  @@index([isActive])
}

// ─── T14: Attendance ──────────────────────────────────────────────────────────

model AttendanceRecord {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  bookingId   String
  classId     String
  studentId   String
  tutorId     String
  sessionDate DateTime
  attended    Boolean  @default(false)
  notes       String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User    @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   User    @relation("TutorAttendance", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([bookingId, sessionDate])
  @@index([classId])
  @@index([studentId])
  @@index([tutorId])
  @@index([sessionDate])
}

// ─── T18: Referrals ───────────────────────────────────────────────────────────

model Referral {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  referrerId  String
  referredId  String    @unique
  completedAt DateTime?
  creditEgp   Int       @default(0)

  referrer User @relation("ReferralsSent", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([completedAt])
}

// ─── T20: Search Logs ─────────────────────────────────────────────────────────

model SearchLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  query       String
  userId      String?
  resultCount Int      @default(0)
  type        String   @default("all")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([query])
  @@index([userId])
}

// ─── T21: Platform Config ─────────────────────────────────────────────────────

model PlatformConfig {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
  key       String   @unique
  value     String

  @@index([key])
}
