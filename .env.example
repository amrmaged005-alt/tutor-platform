# ─── Database (Supabase / PostgreSQL) ────────────────────────────────────────
# Pooled connection via PgBouncer — used by Prisma at runtime (pgbouncer=true required)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — used by Prisma for migrations and schema introspection
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ─── NextAuth v5 ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET="your-secret-here"

# Your production URL (no trailing slash). Used for OAuth callbacks and email links.
# On Vercel this is set automatically via VERCEL_URL, but explicit is safer.
NEXTAUTH_URL="https://your-domain.vercel.app"

# ─── Paymob (payment gateway) ────────────────────────────────────────────────
PAYMOB_API_KEY="your-paymob-api-key"
PAYMOB_INTEGRATION_ID="your-integration-id"
PAYMOB_HMAC_SECRET="your-hmac-secret"
PAYMOB_IFRAME_ID="your-iframe-id"

# ─── Upstash Redis (rate limiting) ───────────────────────────────────────────
# Create a Redis database at https://console.upstash.com — fails open if missing
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Resend (transactional email — currently disabled) ───────────────────────
# Required when email verification is re-enabled in lib/email.ts
RESEND_API_KEY="re_your_key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ─── Feature flags ───────────────────────────────────────────────────────────
# Set to "true" to require email verification on signup (lib/email.ts must be enabled first)
REQUIRE_EMAIL_VERIFICATION="false"
